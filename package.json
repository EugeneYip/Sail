{
  "name": "leeward",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "node scripts/check-glsl.mjs && tsc --noEmit",
    "preview": "vite preview",
    "check-glsl": "node scripts/check-glsl.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check-shaders": "node scripts/check-shaders.mjs",
    "geometry-test": "node scripts/geometry-test.mjs",
    "measure-selftest": "node scripts/measure-selftest.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-glsl": "^1.3.1"
  },
  "description": "An endless procedural tall-ship sailing game in the browser. Three.js, WebGL2, everything generated in code."
}
